# Ambiente e Servidor
NODE_ENV=development
PORT=3001
PUBLIC_PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Banco de Dados PostgreSQL (Docker / Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/black_amber_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=black_amber_db
DB_SSL=false
AUTO_SEED=true

# Autenticação JWT
JWT_SECRET=black_amber_dev_jwt_secret_min_16_chars
JWT_SECRET_REFRESH=black_amber_dev_refresh_secret_min_16_chars
JWT_EXPIRATION=15m

# Armazenamento de Imagens S3 / Cloudflare R2
BUCKET_NAME=imagens
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_URL=
BUCKET_PUBLIC_URL=
BUCKET_REGION=us-east-1

# Envio de E-mails Transacionais (Resend)
RESEND_API_KEY=
SYSTEM_MAIL_ADDR=onboarding@resend.dev
